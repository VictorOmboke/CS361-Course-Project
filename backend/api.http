###### User Auth test routes
@authUrl = http://localhost:{{$dotenv EXPRESS_PORT}}/api/auth

@userId = 10

### 1. Register a New User
POST {{authUrl}}/register
Content-Type: application/json

{
    "firstName": "John",
    "lastName": "Doe",
    "email": "johnd@example.com",
    "password": "SecurePassword123!"
}

### 2. Log in to get access token and set the refresh token
# @name loginRequest
POST {{authUrl}}/login
Content-Type: application/json

{
    "email": "johnd@example.com",
    "providedPassword": "SecurePassword123!"
}

### 3. Capture access token from login response
@accessToken = {{loginRequest.response.body.accessToken}}

### 4. Get user profile
GET {{authUrl}}/profile/{{userId}}
Authorization: bearer {{accessToken}}

### 5. Test refresh token endpoint
# @name refreshTokenRequest
POST {{authUrl}}/refresh-token

### 6. Store new access token
@newAccessToken = {{refreshTokenRequest.response.body.accessToken}}

### 7. Update a user's names
PATCH {{authUrl}}/profile/{{userId}}
Authorization: bearer {{newAccessToken}}
Content-Type: application/json

{
    "newFirstName": "James",
    "newLastName": "Smith"
}

### 8. Update a user's password
PATCH {{authUrl}}/password/{{userId}}
Authorization: bearer {{newAccessToken}}
Content-Type: application/json

{
    "password": "SecurePassword123!",
    "newPassword": "NewSuperSecurePassword123!"
}

### 9. Delete a user
DELETE {{authUrl}}/user/{{userId}}
Authorization: bearer {{newAccessToken}}

###### Watchlist route tests
@watchlistUrl = http://localhost:{{$dotenv EXPRESS_PORT}}/api/watchlist

### 1. Add a movie to user watchlist
POST {{watchlistUrl}}/
Authorization: bearer {{accessToken}}
Content-Type: application/json

{
    "tmdb_id": 157336,
    "type": "movie"
}

###2. Add show to user watchlist
POST {{watchlistUrl}}/
Authorization: bearer {{accessToken}}
Content-Type: application/json

{
    "tmdb_id": 1396,
    "type": "show"
}

### 3. Add movie already in watchlist
POST {{watchlistUrl}}/
Authorization: bearer {{accessToken}}
Content-Type: application/json

{
    "tmdb_id": 157336,
    "type": "movie"
}

### 4. Add Show already in media items but not watchlist
POST {{watchlistUrl}}/
Authorization: bearer {{accessToken}}
Content-Type: application/json

{
    "tmdb_id": 1399,
    "type": "show"
}

### 5. Get watchlist items for a user
GET {{watchlistUrl}}/
Authorization: bearer {{accessToken}}
Content-Type: application/json

### 6. Get watchlist item details
GET {{watchlistUrl}}/media_item/10
Authorization: bearer {{accessToken}}
Content-Type: application/json

### 7. Update a watchlist items watch state
PATCH {{watchlistUrl}}/item/12
Authorization: bearer {{accessToken}}
Content-Type: application/json

{
    "newWatchState": true
}

### 7. Delete watchlist item
DELETE {{watchlistUrl}}/item/14
Authorization: bearer {{accessToken}}
Content-Type: application/json

###### Search Routes
@searchUrl= http://localhost:{{$dotenv EXPRESS_PORT}}/api/search

### 1. Search for a movie title
GET {{searchUrl}}/?query=Shameless
Authorization: bearer {{accessToken}}
